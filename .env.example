# =============================================================================
# NetBox Docker - Configuração Global (.env)
# =============================================================================
# Este arquivo deve ficar na RAIZ do projeto (/opt/netbox-docker/.env)
# e serve como fonte única da verdade para:
#   - Docker Compose (via env_file no docker-compose.override.yml)
#   - Scripts shell (install.sh)
#   - Outras imagens Docker customizadas
#
# Uso:
#   cp .env.example .env
#   nano .env  # Edite as variáveis conforme necessário
# =============================================================================

# Versão da imagem NetBox Docker
NETBOX_VERSION=netboxcommunity/netbox:v4.5.8-4.0.2

# Porta de acesso ao NetBox (host:container - não altere o :8080 no docker-compose)
NETBOX_PORT=8000

# Hosts permitidos (CRÍTICO para produção! FQDNs e IPs que acessam o NetBox)
ALLOWED_HOSTS="localhost 127.0.0.1 ::1"

# Credenciais do Superusuário (primeiro acesso)
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=Admin@1234567890
SKIP_SUPERUSER=false  # Alterar para "true" para pular criação do superusuário

# Fuso horário (padrão: America/Sao_Paulo)
TIME_ZONE=America/Sao_Paulo

# =============================================================================
# BANCO DE DADOS POSTGRESQL
# =============================================================================
# O NetBox usa DB_HOST/DB_PASSWORD, mas o container PostgreSQL usa POSTGRES_DB/POSTGRES_PASSWORD
# ATENÇÃO: Mantenha DB_PASSWORD igual a POSTGRES_PASSWORD!
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=J5brHrAXFLQSif0K

POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=J5brHrAXFLQSif0K

# =============================================================================
# REDIS (Task Queue)
# =============================================================================
REDIS_HOST=redis
REDIS_DATABASE=0
REDIS_PASSWORD=H733Kdjndks81

# =============================================================================
# REDIS (Cache)
# =============================================================================
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_DATABASE=1
REDIS_CACHE_PASSWORD=t4Ph722qJ5QHeQ1qfu36

# =============================================================================
# SEGURANÇA
# =============================================================================
# Chave Secreta do Django (NÃO deixe vazia!)
# Como gerar (padrão oficial netbox-docker):
#   cd /opt/netbox-docker/netbox
#   docker compose --env-file /opt/netbox-docker/.env run netbox python3 /opt/netbox/netbox/generate_secret_key.py
SECRET_KEY=
