# =============================================================================
# NetBox Docker - Exemplo de Configuração (.env)
# =============================================================================
# Copie este arquivo para .env e ajuste as variáveis conforme necessário:
#   cp .env.example .env
#
# NOTA: Senhas geradas seguindo o padrão oficial do netbox-docker
# (https://github.com/netbox-community/netbox-docker/tree/c6cd7ef2de050803b986c17765b8aa54282dbb3e/env)
# =============================================================================

# Versão do NetBox Docker (https://hub.docker.com/r/netboxcommunity/netbox/tags)
NETBOX_VERSION=v4.5.8-4.0.2

# Porta de acesso ao NetBox (host:container - não altere o :8080)
NETBOX_PORT=8000

# Hosts permitidos (CRÍTICO para produção!)
# Adicione todos os FQDNs e IPs que levam ao seu NetBox
ALLOWED_HOSTS="localhost 127.0.0.1 ::1"

# Credenciais do Superusuário (primeiro acesso)
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=Admin@1234567890

# Fuso horário (padrão: America/Sao_Paulo)
TIME_ZONE=America/Sao_Paulo

# Configurações do Banco de Dados PostgreSQL
# ATENÇÃO: Mantenha DB_PASSWORD igual a POSTGRES_PASSWORD!
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=J5brHrAXFLQSif0K  # Padrão oficial (altere se necessário)

POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=J5brHrAXFLQSif0K  # Deve ser igual a DB_PASSWORD!

# Configurações do Redis (Task Queue)
REDIS_HOST=redis
REDIS_DATABASE=0
REDIS_PASSWORD=H733Kdjndks81  # Padrão oficial (altere se necessário)

# Configurações do Redis (Cache)
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_DATABASE=1
REDIS_CACHE_PASSWORD=t4Ph722qJ5QHeQ1qfu36  # Padrão oficial (diferente do Redis Task!)

# Configurações de Inicialização
SKIP_SUPERUSER=false  # Alterar para "true" para pular criação do superusuário

# Chave Secreta do Django (gerada automaticamente pelo script install.sh se vazia)
SECRET_KEY=
