# =============================================================================
# NetBox Docker - Exemplo de Configuração (.env)
# =============================================================================
# Copie este arquivo para .env e ajuste as variáveis conforme necessário:
#   cp .env.example .env
# =============================================================================

# Versão do NetBox Docker (https://hub.docker.com/r/netboxcommunity/netbox/tags)
NETBOX_VERSION=v4.5.8-4.0.2

# Porta de acesso ao NetBox (host:container - não altere o :8080)
NETBOX_PORT=8000

# Credenciais do Superusuário (primeiro acesso)
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=Admin@1234567890

# Fuso horário (padrão: America/Sao_Paulo)
TIME_ZONE=America/Sao_Paulo

# Configurações do Banco de Dados PostgreSQL (não alterar a menos que necessário)
POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=netbox

# Configurações do Redis (não alterar a menos que necessário)
REDIS_PASSWORD=

# Configurações de Inicialização
SKIP_SUPERUSER=false  # Alterar para "true" para pular criação do superusuário
