# Exemplo de variáveis de ambiente para o NetBox Docker (Laboratório)
# Copie este arquivo para .env e ajuste os valores conforme necessário

# --- Configurações do NetBox ---
# Versão da imagem (deve coincidir com a do docker-compose.override.yml)
NETBOX_IMAGE=netboxcommunity/netbox:v4.5.8-4.0.2

# Chave secreta (gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=gerar_com_python

# Fuso horário
TIME_ZONE=America/Sao_Paulo

# Controla se o superusuário deve ser criado (false = cria, true = pula após primeira vez)
SKIP_SUPERUSER=false

# --- Credenciais do Superusuário (corrige problema de login) ---
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=admin

# --- Configurações do Banco de Dados (Postgres) ---
POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=netbox

# --- Configurações do Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Configurações do Redis Cache ---
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=
