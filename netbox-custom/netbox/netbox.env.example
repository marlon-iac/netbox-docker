# NetBox Application Environment Variables
# Copy this file to netbox.env and edit as needed

# CRITICAL: Allowed hosts (space-separated)
ALLOWED_HOSTS=localhost 127.0.0.1 ::1

# Secret Key (generate with: docker compose run netbox python3 /opt/netbox/netbox/generate_secret_key.py)
# SECRET_KEY=

# Superuser Configuration (set during first startup, then set SKIP_SUPERUSER=true)
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=changeme
SKIP_SUPERUSER=false

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=changeme

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis Cache Configuration
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=

# Email Configuration (optional)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=25
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_DEFAULT_FROM=netbox@example.com

# Other Settings
MAX_PAGE_SIZE=1000
CORS_ORIGIN_ALLOW_ALL=false
